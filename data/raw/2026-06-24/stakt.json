    {
      "id": 8384218300598,
      "title": "The Stakt Mat Pro XL",
      "handle": "stakt-mat-pro-xl",
      "body_html": "<div data-item-key=\"1767555029.464419\" data-qa=\"virtual-list-item\" id=\"message-list_1767555029.464419\" role=\"listitem\" class=\"c-virtual_list__item\" aria-setsize=\"-1\" tabindex=\"0\">\n<div data-qa-placeholder=\"false\" data-qa-unprocessed=\"false\" data-qa=\"message_container\" class=\"c-message_kit__background p-message_pane_message__message c-message_kit__message\" role=\"presentation\">\n<div data-qa-hover=\"true\" class=\"c-message_kit__hover\" aria-roledescription=\"message\" role=\"document\">\n<div class=\"c-message_kit__actions c-message_kit__actions--above\">\n<div class=\"c-message_kit__gutter\">\n<div data-qa=\"message_content\" class=\"c-message_kit__gutter__right\" role=\"presentation\">\n<div class=\"c-message_kit__blocks c-message_kit__blocks--rich_text\">\n<div data-qa=\"message-text\" class=\"c-message__message_blocks c-message__message_blocks--rich_text\">\n<div data-qa=\"block-kit-renderer\" class=\"p-block_kit_renderer\">\n<div class=\"p-block_kit_renderer__block_wrapper p-block_kit_renderer__block_wrapper--first\">\n<div dir=\"auto\" class=\"p-rich_text_block\">\n<div class=\"p-rich_text_section\">Meet the Stakt Mat Pro XL -  the same premium, ultra-supportive mat you love, now with even more room to move. At <b data-stringify-type=\"bold\">80\" x 28\"</b>, it’s longer and wider than the original Stakt Mat Pro (<b data-stringify-type=\"bold\">69\" x 24\"</b>), giving you extra comfort, stability, and space for every flow, sculpt, or stretch. Perfect for taller users or anyone who wants a little more wiggle room on the mat.</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div data-item-key=\"1767555110.049969\" data-qa=\"virtual-list-item\" id=\"message-list_1767555110.049969\" role=\"listitem\" class=\"c-virtual_list__item\" aria-setsize=\"-1\" tabindex=\"-1\">\n<div data-qa-placeholder=\"false\" data-qa-unprocessed=\"false\" data-qa=\"message_container\" class=\"c-message_kit__background p-message_pane_message__message c-message_kit__message\" role=\"presentation\">\n<div data-qa-hover=\"true\" class=\"c-message_kit__hover\" aria-roledescription=\"message\" role=\"document\">\n<div class=\"c-message_kit__actions c-message_kit__actions--above\">\n<div class=\"c-message_kit__gutter\">\n<div class=\"c-message_kit__gutter__left\" role=\"presentation\"><br></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<p>Unfolded: 80\" W x 28\" L<br>Folded: 28\" x 10\" x 4\"</p>",
